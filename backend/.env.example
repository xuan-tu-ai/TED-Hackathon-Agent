# Backend Environment Variables
#
# Required — all three MUST be set (no computed defaults).
AGENT_KNOWLEDGE_DIR=C:/DataImpact/TED-Hackathon-Agent/backend/agent_knowledge
DATA_DIR=C:/DataImpact/TED-Hackathon-Agent/data
DATABASE_URL=sqlite+pysqlite:///C:/DataImpact/TED-Hackathon-Agent/data/demo.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/robot_agent
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST.postgres.database.azure.com:5432/robot_agent?sslmode=require

# ── Optional sub-path overrides (default under DATA_DIR) ──────
# CHROMA_DB_PATH=
# SESSION_DIR=
# MEMORY_DIR=
# GENERATED_DATA_DIR=
LOG_LEVEL=INFO

# ── LLM Configuration ──────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here
# LM_PROVIDER=openai
# LM_MODEL=gpt-4o-mini
# LM_API_KEY=
# LM_API_BASE=

# ── Model Configuration (anomaly detection) ────────────────────
MODEL_DEVICE=cuda
GLC_FLOW_MODEL_PATH=./models/checkpoints


## Databricks Configuration
DATABRICKS_HOST="adb-..."
DATABRICKS_TOKEN="dapi..."
DATABRICKS_PATH="sql/protocolv1/o/.../..."
