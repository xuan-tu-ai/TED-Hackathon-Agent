# Backend Environment Variables
#
# Required — all three MUST be set (no computed defaults).
AGENT_KNOWLEDGE_DIR=C:/DataImpact/TED-Hackathon-Agent/backend/agent_knowledge
DATA_DIR=C:/DataImpact/TED-Hackathon-Agent/data
DATABASE_URL=sqlite+pysqlite:///C:/DataImpact/TED-Hackathon-Agent/data/demo.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/robot_agent
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST.postgres.database.azure.com:5432/robot_agent?sslmode=require

# ── Optional sub-path overrides (default under DATA_DIR) ──────
# CHROMA_DB_PATH=
# SESSION_DIR=
# MEMORY_DIR=
# GENERATED_DATA_DIR=
LOG_LEVEL=INFO

# ── LLM Configuration ──────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here
# LM_PROVIDER=openai
# LM_MODEL=gpt-4o-mini
# LM_API_KEY=
# LM_API_BASE=

# ── Databricks (OT data: perception_results, pm_cards, maintenance_events) ──
# All 5 are required when running the simulation engine or querying OT data.
# DATABRICKS_HOST=adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123def456
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_CATALOG=demo
# DATABRICKS_SCHEMA=robot_forensics

# ── SQLite (agent state: incidents, alerts, reports, hitl_queue, agent_memories) ──
# DATABASE_URL is retained for the 5 agent-state tables.
# The Databricks env vars above handle OT data tables.

# ── Model Configuration (anomaly detection) ────────────────────
MODEL_DEVICE=cuda
GLC_FLOW_MODEL_PATH=./models/checkpoints


## Databricks Configuration
DATABRICKS_HOST="adb-..."
DATABRICKS_TOKEN="dapi..."
DATABRICKS_PATH="sql/protocolv1/o/.../..."
