# Anomaly Detection Environment Variables
#
# Required — DATA_DIR must be set.
DATA_DIR=C:/DataImpact/TED-Hackathon-Agent/data

# ── Databricks (OT data: perception_results, pm_cards, maintenance_events) ──
# All 5 are required when running the simulation engine or querying OT data.
# DATABRICKS_HOST=adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123def456
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_CATALOG=demo
# DATABRICKS_SCHEMA=robot_forensics

# ── Model Configuration (anomaly detection) ────────────────────
MODEL_DEVICE=cuda
GLC_FLOW_MODEL_PATH=./checkpoints


