# ═══════════════════════════════════════════════════════════════════
#  SINGLE SOURCE OF TRUTH — Backend API URLs
# ═══════════════════════════════════════════════════════════════════
#  Dev local:  VITE_API_URL=''  → relative URLs → Vite proxy handles routing
#  Docker:     (not set)        → relative URLs → Nginx proxy handles routing
#  Azure CI:   set in workflow  → full URLs     → direct API calls (inlined at build)
#
#  Frontend code reads API_BASE from src/api/config.js, which uses this env var.
#  Vite config & nginx.conf also reference these values.
# ═══════════════════════════════════════════════════════════════════

# Empty = relative URLs (Vite proxy / Nginx will handle)
VITE_API_URL=''

# WebSocket URL (only used by vite.config.js proxy + nginx.conf)
VITE_WS_URL='wss://app-ted-hackathon-be-dev-001.azurewebsites.net'
